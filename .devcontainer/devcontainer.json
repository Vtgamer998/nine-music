{
  "name": "NINE-Music",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "bash scripts/codespace_setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": false
      }
    }
  },
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "NINE-Music UI",
      "onAutoForward": "notify"
    }
  }
}
